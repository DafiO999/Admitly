# Copy to .env for local development with the PostgreSQL Compose service.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
DEMO_DATA_MODE=true

# These credentials are local examples only. Never reuse them in production.
# Optional when host port 5432 is unavailable; change both URLs below to match.
# ADMITLY_DEV_DB_PORT=5432
DATABASE_URL=postgresql://admitly:admitly@localhost:5432/admitly?schema=public
TEST_DATABASE_URL=postgresql://admitly:admitly@localhost:5432/admitly?schema=admitly_test

# Optional for deterministic endpoints.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
COLLEGE_SCORECARD_API_KEY=
