# Copy to .env for local development. No database is needed for milestone 1.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
DEMO_DATA_MODE=true

# Required for production startup once PostgreSQL is configured.
DATABASE_URL=

# Optional for deterministic endpoints.
GEMINI_API_KEY=
GEMINI_MODEL=
COLLEGE_SCORECARD_API_KEY=
