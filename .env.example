# Copy to .env for local development with the PostgreSQL Compose service.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
DEMO_DATA_MODE=true

# These credentials are local examples only. Never reuse them in production.
# Optional when host port 5432 is unavailable; change both URLs below to match.
# ADMITLY_DEV_DB_PORT=5432
DATABASE_URL=postgresql://admitly:admitly@localhost:5432/admitly?schema=public
TEST_DATABASE_URL=postgresql://admitly:admitly@localhost:5432/admitly?schema=admitly_test

# Optional for deterministic endpoints.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_LETTER_MODEL=gemini-3.5-flash-lite
MAIL_DELIVERY_MODE=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Admitly
COLLEGE_SCORECARD_API_KEY=
# Generate a private value for production, for example: openssl rand -base64 48
PROFILE_ACCESS_SECRET=

# Private letter attachments (defaults to .data/uploads in development).
# LETTER_UPLOAD_DIR=.data/uploads
LETTER_ATTACHMENT_MAX_FILE_BYTES=10485760
LETTER_ATTACHMENT_MAX_TOTAL_BYTES=20971520
