generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StudyField {
  computer_science
  engineering
  business
  economics
  design
  other
}

enum UniversityProviderKind {
  college_scorecard
  curated
  demo
}

enum SourceStatus {
  official
  verified
  demo
  unknown
}

enum RequirementKind {
  application_deadline
  english
  sat_act
  document
  gpa
  other
}

enum RoadmapCategory {
  exam
  document
  application
  academic
  activity
  research
}

enum RoadmapStatus {
  pending
  in_progress
  done
  blocked
}

model Profile {
  id                 String              @id @default(uuid()) @db.Uuid
  payload            Json
  profileHash        String
  targetField        StudyField
  targetIntakeYear   Int
  gpaValue           Float
  gpaScale           Int
  gpaNormalized      Float
  annualBudgetUsd    Int
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  recommendationRuns RecommendationRun[]
  roadmaps           Roadmap[]

  @@index([profileHash])
  @@index([targetField, targetIntakeYear])
}

model University {
  id                   String                 @id
  provider             UniversityProviderKind
  name                 String
  city                 String?
  state                String?
  websiteUrl           String?
  studentSize          Int?
  admissionRate        Float?
  tuitionOutOfStateUsd Int?
  averageNetPriceUsd   Int?
  satMedian            Int?
  programs             Json
  dataYear             Int?
  sourceUrl            String?
  sourceStatus         SourceStatus
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  requirements         AdmissionRequirement[]

  @@index([name])
  @@index([state])
}

model AdmissionRequirement {
  id           String          @id
  universityId String
  university   University      @relation(fields: [universityId], references: [id], onDelete: Cascade)
  programKey   String?
  kind         RequirementKind
  label        String
  valueText    String
  numericValue Float?
  date         DateTime?       @db.Date
  sourceUrl    String?
  sourceTitle  String?
  sourceStatus SourceStatus
  checkedAt    DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([universityId, kind])
}

model RecommendationRun {
  id            String    @id @default(uuid()) @db.Uuid
  profileId     String    @db.Uuid
  profile       Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileHash   String
  engineVersion String
  result        Json
  createdAt     DateTime  @default(now())
  roadmaps      Roadmap[]

  @@index([profileId, createdAt])
}

model Roadmap {
  id                  String             @id @default(uuid()) @db.Uuid
  profileId           String             @db.Uuid
  profile             Profile            @relation(fields: [profileId], references: [id], onDelete: Cascade)
  recommendationRunId String?            @db.Uuid
  recommendationRun   RecommendationRun? @relation(fields: [recommendationRunId], references: [id], onDelete: SetNull)
  profileHash         String
  rulesVersion        String
  sourceCoverage      Json?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  items               RoadmapItem[]

  @@index([profileId, createdAt])
  @@index([recommendationRunId])
}

model RoadmapItem {
  id           String          @id @default(uuid()) @db.Uuid
  roadmapId    String          @db.Uuid
  roadmap      Roadmap         @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  key          String
  title        String
  description  String?
  category     RoadmapCategory
  dueDate      DateTime?       @db.Date
  priority     Int
  status       RoadmapStatus   @default(pending)
  dependsOnIds Json
  sourceUrl    String?
  sourceStatus SourceStatus?
  isNextAction Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([roadmapId, key])
  @@index([roadmapId, status])
}
