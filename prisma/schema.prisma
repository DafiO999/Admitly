generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StudyField {
  computer_science
  engineering
  business
  economics
  design
  other
}

enum UniversityProviderKind {
  college_scorecard
  curated
  demo
}

enum SourceStatus {
  official
  verified
  demo
  unknown
}

enum RequirementKind {
  application_deadline
  english
  sat_act
  document
  gpa
  other
}

enum UniversityContactKind {
  undergraduate_admissions
  international_admissions
  general_admissions
}

enum AdmissionLetterPurpose {
  admissions_inquiry
  application_follow_up
  document_submission
  achievement_update
  program_question
  general
}

enum AdmissionLetterStatus {
  created
  drafts_generated
  draft_selected
  ready_to_send
  sending
  sent
  failed
}

enum LetterVariantKind {
  concise
  balanced
  detailed
}

enum LetterSendAttemptStatus {
  started
  accepted
  failed
  ambiguous
}

enum RoadmapCategory {
  exam
  document
  application
  academic
  activity
  research
}

enum RoadmapStatus {
  pending
  in_progress
  done
  blocked
}

model Profile {
  id                 String              @id @default(uuid()) @db.Uuid
  payload            Json
  profileHash        String
  currentRoadmapId   String?             @db.Uuid
  currentRoadmap     Roadmap?            @relation("CurrentRoadmap", fields: [currentRoadmapId], references: [id], onDelete: SetNull)
  targetField        StudyField
  targetIntakeYear   Int
  gpaValue           Float
  gpaScale           Int
  gpaNormalized      Float
  annualBudgetUsd    Int
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  recommendationRuns RecommendationRun[]
  roadmaps           Roadmap[]
  letters            AdmissionLetter[]

  @@index([profileHash])
  @@index([currentRoadmapId])
  @@index([targetField, targetIntakeYear])
}

model University {
  id                   String                 @id
  provider             UniversityProviderKind
  name                 String
  city                 String?
  state                String?
  websiteUrl           String?
  studentSize          Int?
  admissionRate        Float?
  tuitionOutOfStateUsd Int?
  averageNetPriceUsd   Int?
  satMedian            Int?
  programs             Json
  dataYear             Int?
  sourceUrl            String?
  sourceStatus         SourceStatus
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  requirements         AdmissionRequirement[]
  contacts             UniversityContact[]
  letters              AdmissionLetter[]

  @@index([name])
  @@index([state])
}

model UniversityContact {
  id           String                @id @default(uuid()) @db.Uuid
  universityId String
  university   University            @relation(fields: [universityId], references: [id], onDelete: Cascade)
  kind         UniversityContactKind
  email        String
  sourceUrl    String
  sourceTitle  String?
  sourceStatus SourceStatus
  verifiedAt   DateTime
  active       Boolean               @default(false)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  letters      AdmissionLetter[]

  @@index([universityId, active])
}

model AdmissionLetter {
  id                   String                @id @default(uuid()) @db.Uuid
  profileId            String                @db.Uuid
  profile              Profile               @relation(fields: [profileId], references: [id], onDelete: Cascade)
  universityId         String
  university           University            @relation(fields: [universityId], references: [id], onDelete: Restrict)
  universityContactId  String                @db.Uuid
  universityContact    UniversityContact     @relation(fields: [universityContactId], references: [id], onDelete: Restrict)
  purpose              AdmissionLetterPurpose
  status               AdmissionLetterStatus @default(created)
  senderName           String
  replyToEmail         String
  subject              String?
  body                 String?
  selectedVariantId    String?               @db.Uuid
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  sentAt               DateTime?
  generations          LetterGeneration[]
  attachments          LetterAttachment[]
  sendAttempts         LetterSendAttempt[]

  @@index([profileId, createdAt])
  @@index([universityId, status])
  @@index([universityContactId])
}

model LetterGeneration {
  id                String          @id @default(uuid()) @db.Uuid
  letterId          String          @db.Uuid
  letter            AdmissionLetter @relation(fields: [letterId], references: [id], onDelete: Cascade)
  promptVersion     String
  additionalContext String?
  inputSnapshot     Json
  createdAt         DateTime        @default(now())
  variants          LetterVariant[]

  @@index([letterId, createdAt])
}

model LetterVariant {
  id           String            @id @default(uuid()) @db.Uuid
  generationId String            @db.Uuid
  generation   LetterGeneration  @relation(fields: [generationId], references: [id], onDelete: Cascade)
  variant      LetterVariantKind
  subject      String
  body         String
  createdAt    DateTime          @default(now())

  @@unique([generationId, variant])
}

model LetterAttachment {
  id           String          @id @default(uuid()) @db.Uuid
  letterId     String          @db.Uuid
  letter       AdmissionLetter @relation(fields: [letterId], references: [id], onDelete: Cascade)
  originalName String
  storageKey   String          @unique
  mimeType     String
  sizeBytes    Int
  sha256       String
  createdAt    DateTime        @default(now())

  @@index([letterId, createdAt])
}

model LetterSendAttempt {
  id                String                  @id @default(uuid()) @db.Uuid
  letterId          String                  @db.Uuid
  letter            AdmissionLetter         @relation(fields: [letterId], references: [id], onDelete: Cascade)
  idempotencyKey    String
  status            LetterSendAttemptStatus @default(started)
  provider          String                  @default("smtp")
  recipientEmail    String
  providerMessageId String?
  errorCode         String?
  createdAt         DateTime                @default(now())
  completedAt       DateTime?

  @@unique([letterId, idempotencyKey])
  @@index([letterId, createdAt])
}

model AdmissionRequirement {
  id           String          @id
  universityId String
  university   University      @relation(fields: [universityId], references: [id], onDelete: Cascade)
  programKey   String?
  kind         RequirementKind
  label        String
  valueText    String
  numericValue Float?
  date         DateTime?       @db.Date
  sourceUrl    String?
  sourceTitle  String?
  sourceStatus SourceStatus
  checkedAt    DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([universityId, kind])
}

model RecommendationRun {
  id            String    @id @default(uuid()) @db.Uuid
  profileId     String    @db.Uuid
  profile       Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileHash   String
  engineVersion String
  result        Json
  createdAt     DateTime  @default(now())
  roadmaps      Roadmap[]

  @@index([profileId, createdAt])
}

model Roadmap {
  id                  String             @id @default(uuid()) @db.Uuid
  profileId           String             @db.Uuid
  profile             Profile            @relation(fields: [profileId], references: [id], onDelete: Cascade)
  recommendationRunId String?            @db.Uuid
  recommendationRun   RecommendationRun? @relation(fields: [recommendationRunId], references: [id], onDelete: SetNull)
  profileHash         String
  rulesVersion        String
  selectedUniversityIds Json               @default("[]")
  sourceCoverage      Json?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  items               RoadmapItem[]
  currentForProfiles  Profile[]          @relation("CurrentRoadmap")

  @@index([profileId, createdAt])
  @@index([recommendationRunId])
}

model RoadmapItem {
  id           String          @id @default(uuid()) @db.Uuid
  roadmapId    String          @db.Uuid
  roadmap      Roadmap         @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  key          String
  position     Int             @default(0)
  title        String
  description  String?
  category     RoadmapCategory
  dueDate      DateTime?       @db.Date
  priority     Int
  status       RoadmapStatus   @default(pending)
  dependsOnIds Json
  sourceUrl    String?
  sourceStatus SourceStatus?
  isNextAction Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([roadmapId, key])
  @@unique([roadmapId, position])
  @@index([roadmapId, status])
}
