# Copy to deploy/.env.production and replace every placeholder before deployment.
# Keep this file on the server; never commit deploy/.env.production.
SITE_DOMAIN=admitly.example.invalid
# Caddy publishes 80/tcp and 443/tcp+udp by default. Optional bind overrides:
# CADDY_HTTP_BIND=80
# CADDY_HTTPS_BIND=443
POSTGRES_DB=admitly
POSTGRES_USER=admitly
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Match the PostgreSQL settings above; URL-encode reserved password characters.
DATABASE_URL=postgresql://admitly:replace-with-a-long-random-password@db:5432/admitly?schema=public
DEMO_DATA_MODE=false
COLLEGE_SCORECARD_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
LETTER_UPLOAD_DIR=/data/uploads
LETTER_ATTACHMENT_MAX_FILE_BYTES=10485760
LETTER_ATTACHMENT_MAX_TOTAL_BYTES=20971520
